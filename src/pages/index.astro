---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION } from '../consts';
import { notes } from '../data/notes';
import { postUrl, shortDate } from '../lib/format';

// 초안(draft: true)은 빌드 결과에 넣지 않는다. 로컬 `npm run dev` 에서만 보인다.
const posts = (await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// 마크다운 글과 독립 HTML 글(src/data/notes.ts)을 한 목록으로 합친다.
// sort 는 안정 정렬이라 날짜가 같으면 이 배열 순서(독립 글이 위)가 그대로 남는다.
const entries = [
  ...notes.map((note) => ({ ...note })),
  ...posts.map((post) => ({
    url: postUrl(post.id),
    title: post.data.title,
    description: post.data.description,
    pubDate: post.data.pubDate,
    lang: post.data.lang,
  })),
].sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());
---

<BaseLayout description={SITE_DESCRIPTION}>
  <section class="page-intro">
    <h1>쓰고 싶은 것들을 적어 둡니다</h1>
    <p>
      만들면서 부딪힌 문제, 그 문제를 푼 방식, 그리고 다시 같은 문제를 만났을 때 꺼내 볼 기록.
      백엔드와 인프라가 주된 자리이고, 가끔은 도구 이야기가 섞입니다.
    </p>
  </section>

  {
    entries.length > 0 ? (
      <ul class="post-list">
        {entries.map((entry) => (
          <li>
            <a href={entry.url}>
              <time datetime={entry.pubDate.toISOString()}>{shortDate(entry.pubDate, entry.lang)}</time>
              <span class="post-title">{entry.title}</span>
              <span class="post-desc">{entry.description}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <div class="empty-state">
        <strong>아직 올린 글이 없습니다.</strong>
        첫 글은 <code>src/content/blog/</code> 에 마크다운 파일을 하나 더하면 바로 올라갑니다.
        형식은 <code>templates/post.md</code> 를 복사해서 쓰면 됩니다.
      </div>
    )
  }
</BaseLayout>
