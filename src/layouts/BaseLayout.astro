---
import {
  AUTHOR,
  DEFAULT_OG_IMAGE,
  OG_IMAGE_HEIGHT,
  OG_IMAGE_WIDTH,
  SITE_DESCRIPTION,
  SITE_LANG,
  SITE_TAGLINE,
  SITE_TITLE,
} from '../consts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  lang?: 'ko' | 'en';
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  noindex?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  ogImage = DEFAULT_OG_IMAGE,
  type = 'website',
  lang = SITE_LANG as 'ko' | 'en',
  pubDate,
  updatedDate,
  tags = [],
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE_TITLE}` : `${SITE_TITLE} — ${SITE_TAGLINE}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const locale = lang === 'en' ? 'en_US' : 'ko_KR';

const jsonLd =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        image: ogImageUrl.href,
        datePublished: pubDate?.toISOString(),
        dateModified: (updatedDate ?? pubDate)?.toISOString(),
        inLanguage: lang,
        keywords: tags.join(', '),
        author: { '@type': 'Person', name: AUTHOR, url: Astro.site?.href },
        publisher: { '@type': 'Person', name: AUTHOR },
        mainEntityOfPage: { '@type': 'WebPage', '@id': canonical.href },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: SITE_TITLE,
        alternateName: `${SITE_TITLE} — ${SITE_TAGLINE}`,
        description: SITE_DESCRIPTION,
        url: Astro.site?.href,
        inLanguage: 'ko',
        author: { '@type': 'Person', name: AUTHOR },
      };
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical.href} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={AUTHOR} />
    <meta name="theme-color" content="#fcfcfb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0e10" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph: X(summary_large_image), LinkedIn, Slack, KakaoTalk 등 미리보기 카드 -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={title ?? `${SITE_TITLE} — ${SITE_TAGLINE}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
    <meta property="og:image:alt" content={`${title ?? SITE_TITLE} — ${SITE_TAGLINE}`} />
    <meta property="og:locale" content={locale} />
    {
      type === 'article' && pubDate && (
        <meta property="article:published_time" content={pubDate.toISOString()} />
      )
    }
    {
      type === 'article' && updatedDate && (
        <meta property="article:modified_time" content={updatedDate.toISOString()} />
      )
    }
    {
      type === 'article' &&
        tags.map((tag) => <meta property="article:tag" content={tag} />)
    }

    <!-- X / Twitter 카드 -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? `${SITE_TITLE} — ${SITE_TAGLINE}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl.href} />
    <meta name="twitter:image:alt" content={`${title ?? SITE_TITLE} — ${SITE_TAGLINE}`} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- 깜빡임 없이 첫 페인트 전에 테마를 정한다. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = stored || (prefersDark ? 'dark' : 'light');
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">본문으로 건너뛰기</a>

    <header class="site-header">
      <div class="wrap">
        <div class="brand">
          <a href="/">{SITE_TITLE}</a>
          <span class="tagline">{SITE_TAGLINE}</span>
        </div>
        <nav class="site-nav" aria-label="주 메뉴">
          <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>글</a>
          <a href="/tags/" aria-current={Astro.url.pathname.startsWith('/tags') ? 'page' : undefined}>
            태그
          </a>
          <a href="/rss.xml">RSS</a>
          <button id="theme-toggle" class="theme-toggle" type="button" aria-label="테마 전환">
            <svg
              class="icon-sun"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4.2"></circle>
              <path
                d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6"
              ></path>
            </svg>
            <svg
              class="icon-moon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20.5 14.6A8.6 8.6 0 0 1 9.4 3.5a8.6 8.6 0 1 0 11.1 11.1Z"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="content">
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>&copy; {new Date().getFullYear()} {SITE_TITLE}</span>
        <a href="/rss.xml">RSS</a>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var button = document.getElementById('theme-toggle');
        if (!button) return;

        function render() {
          var dark = root.dataset.theme === 'dark';
          button.setAttribute('aria-label', dark ? '라이트 모드로 전환' : '다크 모드로 전환');
          button.setAttribute('title', dark ? '라이트 모드' : '다크 모드');
        }

        button.addEventListener('click', function () {
          var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try {
            localStorage.setItem('theme', next);
          } catch (e) {}
          render();
        });

        render();
      })();
    </script>
  </body>
</html>
